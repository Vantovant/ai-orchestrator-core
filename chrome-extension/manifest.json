{
  "manifest_version": 3,
  "name": "VantoOS Companion",
  "version": "0.2.0",
  "description": "Capture web pages and manage tasks from VantoOS",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open VantoOS Companion"
  }
}
